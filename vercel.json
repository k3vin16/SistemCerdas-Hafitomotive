{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "proyek_sistem_cerdas/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "proyek_sistem_cerdas/wsgi.py"
    }
  ]
}